<Page x:Class="DebugManager.Pages.ItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#303030">
            <Button Content="← Main Menu" Width="130" Height="38" Margin="14" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock Text="Items / Item Memory" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="#B0BEC5" Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock Text="Per-player received ITEM packets" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Each packet is 8 bytes. Until ITEMPacket's exact field layout is verified, the UI intentionally shows raw bytes rather than guessing an item ID." Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <DataGrid x:Name="PacketGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="300"
                          Background="#252525" Foreground="White" RowBackground="#303030" AlternatingRowBackground="#383838">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/>
                        <DataGridTextColumn Header="Packet bytes (hex)" Binding="{Binding Hex}" Width="*"/>
                        <DataGridTextColumn Header="Timer value (raw uint32)" Binding="{Binding Timer}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Item slot data" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,24,0,8"/>
                <TextBlock x:Name="ItemSlotSummary" Text="Waiting for ItemSlotData..." Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Item behaviour table (19 × 0x1C bytes)" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,24,0,8"/>
                <TextBlock Text="Object ID, item count, use type and function pointer are decoded from the documented offsets in itembehaviour.h. IDs are shown numerically; no name mapping is assumed." Foreground="#B0BEC5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <DataGrid x:Name="BehaviourGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="360"
                          Background="#252525" Foreground="White" RowBackground="#303030" AlternatingRowBackground="#383838">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item table index" Binding="{Binding Index}" Width="120"/>
                        <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="150"/>
                        <DataGridTextColumn Header="Number of items" Binding="{Binding NumberOfItems}" Width="150"/>
                        <DataGridTextColumn Header="Use type" Binding="{Binding UseType}" Width="120"/>
                        <DataGridTextColumn Header="Use function pointer" Binding="{Binding UseFunction}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
