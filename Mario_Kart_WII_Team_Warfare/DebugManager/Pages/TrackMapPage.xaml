<Page x:Class="DebugManager.Pages.TrackMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">
    <Page.Resources>
        <Style x:Key="OverlayCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="12,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#303840" Padding="12,8" BorderBrush="#52616B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button Content="← Main Menu" Width="130" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Back_Click"/>
                    <TextBlock x:Name="HeaderText" Text="Track Map" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="#CFD8DC" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"/><ToggleButton x:Name="View3DToggle" Content="3D TEST" Width="90" Height="32" VerticalAlignment="Center" Checked="View3DToggle_Changed" Unchecked="View3DToggle_Changed"/></StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#202830" BorderBrush="#607D8B" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,8,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="MAP OVERLAYS" Foreground="#80CBC4" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0,18,0" DockPanel.Dock="Left"/>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="CheckpointsToggle" Content="Checkpoints" IsChecked="True" Style="{StaticResource OverlayCheckBox}" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                            <CheckBox x:Name="CpuRoutesToggle" Content="CPU routes" IsChecked="False" Style="{StaticResource OverlayCheckBox}" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                            <CheckBox x:Name="ItemRoutesToggle" Content="Item routes" IsChecked="False" Style="{StaticResource OverlayCheckBox}" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                            <CheckBox x:Name="ObjectsToggle" Content="Track objects" IsChecked="False" Style="{StaticResource OverlayCheckBox}" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <ScrollViewer x:Name="Map2DScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border Padding="10" Background="#151B20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Canvas x:Name="TrackCanvas" Width="1100" Height="700" Background="#263238" ClipToBounds="False"/>
                </Border>
            </ScrollViewer>
            <Border x:Name="Map3DPanel" Background="#151B20" CornerRadius="10" Visibility="Collapsed" ClipToBounds="True">
                <Grid>
                    <Viewport3D x:Name="TrackViewport3D" ClipToBounds="True"
                                PreviewMouseDown="TrackViewport3D_MouseDown"
                                PreviewMouseMove="TrackViewport3D_MouseMove"
                                PreviewMouseUp="TrackViewport3D_MouseUp"
                                PreviewMouseWheel="TrackViewport3D_MouseWheel"/>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="8,5" Background="#D0202830" CornerRadius="4">
                        <TextBlock Text="COURSE_MODEL.BRRES · GREY GEOMETRY · DRAG TO ORBIT · WHEEL TO ZOOM" Foreground="#FFE082" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
