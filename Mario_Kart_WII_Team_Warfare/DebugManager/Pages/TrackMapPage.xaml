<Page x:Class="DebugManager.Pages.TrackMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#303030">
            <Button Content="← Main Menu" Width="130" Height="38" Margin="14" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock x:Name="HeaderText" Text="Track Map" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="#B0BEC5" Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Margin="18" Padding="10" Background="#151B20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Canvas x:Name="TrackCanvas" Width="1100" Height="700" Background="#263238" ClipToBounds="True"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
