<Page x:Class="DebugManager.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <WrapPanel Margin="30"
                   HorizontalAlignment="Center">

            <!-- Race Data -->
            <Border Width="300"
                    Height="240"
                    Margin="15"
                    CornerRadius="12"
                    Background="#303030"
                    Cursor="Hand"
                    MouseLeftButtonUp="RaceData_Click">

                <StackPanel>

                    <Image Source="/Assets/MenuPreviews/RaceData.png"
                           Height="170"
                           Stretch="UniformToFill"/>

                    <TextBlock Text="Race Data"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

            <!-- Track Map -->
            <Border Width="300" Height="240" Margin="15" CornerRadius="12"
                    Background="#303030" Cursor="Hand" MouseLeftButtonUp="TrackMap_Click">
                <StackPanel>
                    <Border Height="170" Background="#263238" CornerRadius="12,12,0,0">
                        <Grid>
                            <Path Stroke="#66D9EF" StrokeThickness="7" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M 25,130 C 80,10 180,10 260,90 S 210,170 145,120"/>
                            <Ellipse Width="30" Height="30" Fill="#FFD54F" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="62,0,0,0"/>
                            <Ellipse Width="30" Height="30" Fill="#EF5350" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,62,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Track Map" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Player Status -->
            <Border Width="300" Height="240" Margin="15" CornerRadius="12"
                    Background="#303030" Cursor="Hand" MouseLeftButtonUp="PlayerStatus_Click">
                <StackPanel>
                    <Border Height="170" Background="#252525" CornerRadius="12,12,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="P1   LAP 2/3    1st" Foreground="#FFFFFF" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Speed       72.4" Foreground="#66D9EF" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Drift        SMT" Foreground="#FFFFFF" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="Effect       STAR" Foreground="#FFD54F" FontSize="18" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Player Status" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Items -->
            <Border Width="300" Height="240" Margin="15" CornerRadius="12"
                    Background="#303030" Cursor="Hand" MouseLeftButtonUp="Items_Click">
                <StackPanel>
                    <Border Height="170" Background="#252525" CornerRadius="12,12,0,0" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="ITEM" Foreground="#FFD54F" FontSize="38" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="12 slots" Foreground="White" FontSize="18"/>
                                <TextBlock Text="Raw packets" Foreground="#B0BEC5" FontSize="15"/>
                                <TextBlock Text="Behaviour table" Foreground="#B0BEC5" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Items" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Temporary portable library validation (independent of the track renderer) -->
            <Border Width="300" Height="240" Margin="15" CornerRadius="12"
                    Background="#2A3744" Cursor="Hand" MouseLeftButtonUp="LibraryValidation_Click">
                <StackPanel>
                    <Border Height="170" Background="#183445" CornerRadius="12,12,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="54"
                                       Foreground="#66D9EF" HorizontalAlignment="Center"/>
                            <TextBlock Text="KMP / BRRES" FontSize="23" FontWeight="Bold"
                                       Foreground="#D9EFFA" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Portable library diagnostics" FontSize="13"
                                       Foreground="#A9C9DC" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Library Validation" Foreground="White" FontSize="22"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Scene Data -->
            <Border Width="300"
                    Height="240"
                    Margin="15"
                    CornerRadius="12"
                    Background="#303030"
                    Cursor="Hand">

                <StackPanel>

                    <Image Source="/Assets/MenuPreviews/SceneData.png"
                           Height="170"
                           Stretch="UniformToFill"/>

                    <TextBlock Text="Scene Data"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </WrapPanel>

    </ScrollViewer>

</Page>
