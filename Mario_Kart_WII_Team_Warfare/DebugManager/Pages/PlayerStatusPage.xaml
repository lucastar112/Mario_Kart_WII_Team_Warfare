<Page x:Class="DebugManager.Pages.PlayerStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#303030">
            <Button Content="← Main Menu" Width="130" Height="38" Margin="14" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock Text="Player Status" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="#B0BEC5" Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <DataGrid x:Name="PlayersGrid" Grid.Row="1" Margin="18" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" Background="#252525" Foreground="White"
                  RowBackground="#303030" AlternatingRowBackground="#383838" BorderBrush="#505050"
                  ItemsSource="{Binding Players}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Slot" Binding="{Binding PlayerId}" Width="55"/>
                <DataGridTextColumn Header="Type" Binding="{Binding PlayerTypeText}" Width="85"/>
                <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                <DataGridTextColumn Header="Place" Binding="{Binding PositionText}" Width="65"/>
                <DataGridTextColumn Header="Lap" Binding="{Binding LapText}" Width="65"/>
                <DataGridTextColumn Header="Race completion" Binding="{Binding CompletionText}" Width="115"/>
                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="85"/>
                <DataGridTextColumn Header="Drift" Binding="{Binding DriftText}" Width="105"/>
                <DataGridTextColumn Header="MT charge" Binding="{Binding MtCharge}" Width="85"/>
                <DataGridTextColumn Header="SMT charge" Binding="{Binding SmtCharge}" Width="90"/>
                <DataGridTextColumn Header="Effect" Binding="{Binding EffectText}" Width="180"/>
                <DataGridTextColumn Header="Star" Binding="{Binding StarTimer}" Width="60"/>
                <DataGridTextColumn Header="Mega" Binding="{Binding MegaTimer}" Width="60"/>
                <DataGridTextColumn Header="Shock" Binding="{Binding ShockTimer}" Width="65"/>
                <DataGridTextColumn Header="Crush" Binding="{Binding CrushTimer}" Width="65"/>
                <DataGridTextColumn Header="Respawn" Binding="{Binding RespawnState}" Width="75"/>
                <DataGridTextColumn Header="Pre-respawn" Binding="{Binding PreRespawnTimer}" Width="95"/>
                <DataGridTextColumn Header="Out-of-bounds" Binding="{Binding SolidOutOfBoundsTimer}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
