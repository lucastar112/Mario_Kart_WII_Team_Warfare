<Page x:Class="DebugManager.Pages.LibraryValidationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#171C24">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Background" Value="#2F485F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#202935"/>
            <Setter Property="Foreground" Value="#E5EDF5"/>
            <Setter Property="RowBackground" Value="#253141"/>
            <Setter Property="AlternatingRowBackground" Value="#29384A"/>
            <Setter Property="BorderBrush" Value="#394B61"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#344458"/>
            <Setter Property="VerticalGridLinesBrush" Value="#344458"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
        </Style>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel>
                <Button Content="Back to menu" Click="Back_Click" DockPanel.Dock="Right"/>
                <TextBlock Text="GameManager.Tools · Library Validation" Foreground="#66D9EF"
                           FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Read an actual SZS archive using portable KMP, KCL and all three BRRES import profiles. No OpenGL context or Dolphin connection required."
                       Foreground="#ACBBCB" Margin="0,8,0,12"/>
            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <Button x:Name="RunButton" Content="Run validation" Click="Run_Click" DockPanel.Dock="Right"/>
                <Button Content="Browse .szs" Click="Browse_Click" DockPanel.Dock="Right"/>
                <TextBox x:Name="ArchivePathBox" Height="33" FontSize="14" VerticalContentAlignment="Center"
                         Background="#253141" Foreground="White" BorderBrush="#50657A"
                         ToolTip="Path to a Nintendo or custom course .szs archive"/>
            </DockPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Choose a .szs file to begin."
                   Foreground="#E4D18B" FontWeight="SemiBold" Margin="0,6,0,12"/>
        <TabControl Grid.Row="2" Background="#202935" Foreground="White">
            <TabItem Header="Overview &amp; checks">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ProfileGrid" Grid.Row="0" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="GeometryOnly — top-down X/Z mesh (sampled triangles)" Margin="0,0,8,0" Foreground="#DBE6EF">
                            <Image x:Name="GeometryPreview" Stretch="Uniform"/>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="BaselineTextured — decoded TEX0 RGBA preview" Margin="8,0,0,0" Foreground="#DBE6EF">
                            <DockPanel LastChildFill="True" Margin="8">
                                <TextBlock DockPanel.Dock="Bottom" x:Name="TextureCaption" Foreground="#B4C5D7"
                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                <Image x:Name="TexturePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="KMP sections &amp; checkpoints">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="KmpSummaryText" Grid.Row="0" Margin="0,0,0,10" Foreground="#ACBBCB"/>
                    <DataGrid x:Name="KmpGrid" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="KCL collision data">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="KclSummaryText" Foreground="#ACBBCB"/>
                        <TextBlock Text="Phase 4: filter by KCL base type (low 5 bits); full 16-bit flags retain their individual colors. Drag to orbit; wheel to zoom."
                                   Foreground="#ACBBCB" Margin="0,5,0,0"/>
                        <CheckBox x:Name="KclColorModeBox" Content="Color by collision ID (uncheck for gray)" IsChecked="True"
                                  Foreground="#DCE7F3" Margin="0,7,0,0"
                                  Checked="KclColorMode_Changed" Unchecked="KclColorMode_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                            <TextBlock Text="Base collision types:" Foreground="#DCE7F3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="All" Click="KclFilterAll_Click" Padding="10,3" Margin="0,0,5,0"/>
                            <Button Content="None" Click="KclFilterNone_Click" Padding="10,3" Margin="0,0,5,0"/>
                            <Button Content="Invert" Click="KclFilterInvert_Click" Padding="10,3"/>
                        </StackPanel>
                        <TextBlock Text="Group presets (select only this group):" Foreground="#DCE7F3" Margin="0,5,0,4"/>
                        <WrapPanel x:Name="KclGroupPresetPanel" Margin="0,0,0,5"/>
                        <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="KclTypeFilterPanel"/>
                        </ScrollViewer>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border BorderBrush="#394B61" BorderThickness="1" Background="#111820" Margin="0,0,8,0">
                            <Grid>
                                <Viewport3D x:Name="KclViewport" ClipToBounds="True"
                                            MouseLeftButtonDown="KclViewport_MouseLeftButtonDown"
                                            MouseLeftButtonUp="KclViewport_MouseLeftButtonUp"
                                            MouseMove="KclViewport_MouseMove"
                                            MouseWheel="KclViewport_MouseWheel">
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera x:Name="KclCamera" FieldOfView="50" NearPlaneDistance="0.1" FarPlaneDistance="10000000"/>
                                    </Viewport3D.Camera>
                                    <ModelVisual3D>
                                        <ModelVisual3D.Content>
                                            <Model3DGroup>
                                                <AmbientLight Color="#888888"/>
                                                <DirectionalLight Color="#FFFFFF" Direction="-0.4,-1,-0.6"/>
                                                <DirectionalLight Color="#666666" Direction="0.6,0.5,0.3"/>
                                            </Model3DGroup>
                                        </ModelVisual3D.Content>
                                    </ModelVisual3D>
                                    <ModelVisual3D x:Name="KclModelVisual"/>
                                </Viewport3D>
                                <TextBlock x:Name="KclViewportHint" Text="Run validation to load the KCL mesh"
                                           Foreground="#D8E2EC" Background="#88111820" Padding="8"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="KclGrid" Grid.Column="1"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="TEV metadata">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Decoded GX stages from the TevMetadata profile (data only; not pixel-perfect GX rendering)."
                               Foreground="#ACBBCB" Margin="0,0,0,10"/>
                    <DataGrid x:Name="TevGrid" Grid.Row="1"/>
                </Grid>
            </TabItem>
            <TabItem Header="Full report">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Copy report" Click="Copy_Click"/>
                        <Button Content="Save report..." Click="Save_Click"/>
                    </StackPanel>
                    <TextBox x:Name="ReportBox" Background="#111820" Foreground="#DAE4EF"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
