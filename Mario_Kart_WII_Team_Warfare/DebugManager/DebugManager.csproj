<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\MenuPreviews\" />
    <Folder Include="Assets\Characters\" />
    <Folder Include="Assets\Vehicles\" />
    <Folder Include="Assets\Tracks\" />
    <Folder Include="Menus\" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="Assets\MenuPreviews\*.png" />
	<Resource Include="Assets\Characters\*.png" />
	<Resource Include="Assets\Vehicles\*.png" />
    <Resource Include="Assets\Tracks\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\libraries\GameManager.Shared\GameManager.Shared\GameManager.Shared.csproj" />
    <ProjectReference Include="..\..\..\..\libraries\GameManager.Tools\GameManager.Tools\GameManager.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
	<None Update="Assets\MenuPreviews\**\*.png">
	 <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>

	<None Update="Assets\Characters\**\*.png">
	 <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>

	<None Update="Assets\Vehicles\**\*.png">
	 <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>

    <None Update="Assets\Tracks\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\..\..\..\GameManagerSolution\bin\Debug\net10.0\games\MTW\DEV\childrens\$(AssemblyName)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\..\..\..\GameManagerSolution\bin\Release\net10.0\games\MTW\REL\childrens\$(AssemblyName)\</OutputPath>
  </PropertyGroup>

</Project>
