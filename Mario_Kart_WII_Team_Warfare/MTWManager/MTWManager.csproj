<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\..\..\..\GameManagerSolution\bin\Debug\$(TargetFramework)\games\MTW\DEV\childrens\$(AssemblyName)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\..\..\..\GameManagerSolution\bin\Release\$(TargetFramework)\games\MTW\REL\childrens\$(AssemblyName)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\libraries\GameManager.Shared\GameManager.Shared\GameManager.Shared.csproj" />
	<ProjectReference Include="..\..\..\..\libraries\GameManager.Dolphin\GameManager.Dolphin\GameManager.Dolphin.csproj" />
  </ItemGroup>

	<!-- Debug / DEV -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">

		<None Include="src\Config\memory.json">
			<Link>..\..\config\memory.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Include="src\Config\Debug\children.json">
			<Link>..\..\config\children.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

	<!-- Release / REL -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">

		<None Include="src\Config\memory.json">
			<Link>..\..\config\memory.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Include="src\Config\Release\children.json">
			<Link>..\..\config\children.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

</Project>
